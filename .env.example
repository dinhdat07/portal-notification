# Database (For Outbox/Delivery State)
DB_URL=postgres://postgres:postgres@localhost:5433/postgres?sslmode=disable

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_NOTIFICATION_REQUESTED_TOPIC=portal.notification.requested
KAFKA_CONSUMER_GROUP=notification-service

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_AUTH=false
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@portal.local
SMTP_FROM_NAME="Portal System"

# Circuit Breaker Config
SMTP_CB_MAX_REQUESTS=5
SMTP_CB_INTERVAL_SECONDS=60
SMTP_CB_TIMEOUT_SECONDS=30
SMTP_CB_FAILURE_THRESHOLD=5

# Worker Retry Config
WORKER_FETCH_RETRY_INITIAL_BACKOFF=100ms
WORKER_FETCH_RETRY_MAX_BACKOFF=5s
WORKER_MAX_RETRY=3
WORKER_DELIVERY_RETRY_INITIAL_BACKOFF=100ms
WORKER_DELIVERY_RETRY_MAX_BACKOFF=5s

# Observability
METRICS_PORT=9090
LOG_LEVEL=info
